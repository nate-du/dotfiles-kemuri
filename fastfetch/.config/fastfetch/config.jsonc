{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "$HOME/.config/fastfetch/yorha.png",
    "width": 15,
    "height": null,
    "padding": {
      "top": 2,
      "left": 5,
      "right": 6
    },
    "preserveAspectRatio": true,
    "printRemaining": false,
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "default",
      "title": "default",
      "output": "default",
      "separator": "default"
    },
    "key": {
      "type": "icon"
    }
  },
  "general": {
    "thread": true,
    "processingTimeout": 5000,
    "detectVersion": true,
    "playerName": "",
    "dsForceDrm": false
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "YoRHa「人類に栄光あれ」"
    },
    {
      "type": "os"
    },
    {
      "type": "kernel",
      "format": "{release}"
    },
        {
      "type": "de",
      "keyIcon": "",
      "slowVersionDetection": false,
      "format": "{pretty-name}"
    },
    {
      "type": "shell"
    },
    {
      "type": "terminal",
      "keyIcon": ""
    },
    {
      "type": "packages",
      "keyIcon": "󰏖",
      "disabled": [
        "apk"
      ],
      "combined": false
    },
    {
      "type": "uptime",
      "keyIcon":"󰅐"
    },
    // "host",
    // {
    //   "type": "cpu",
    //   "key": "󰍛",
    //   "format": "{name}"
    // },
    // {
    //   "type": "gpu",
    //   "format": "{name}"
    // },
    // {
    //   "type": "memory",
    //   "format": "{used} / {total}"
    // },
    // "break",
    "break"
  ]
}
